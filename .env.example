# =============================================================
#  Variables de entorno - Gestor Taller
#  Copiar a .env y completar. .env NUNCA se commitea.
# =============================================================

# --- Frontend (apps/web) ---------------------------------------------------
# Solo estas dos llegan al navegador. Van con prefijo VITE_ porque Vite
# unicamente expone al bundle las que empiezan asi.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# !!! NUNCA poner SUPABASE_SERVICE_ROLE_KEY con prefijo VITE_ !!!
# Esa clave saltea todas las policies de RLS. Si entra al bundle de Vite,
# cualquiera que abra las devtools puede leer y borrar la base entera.


# --- Edge Functions (supabase/functions) -----------------------------------
# Se cargan con: supabase secrets set --env-file .env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY las inyecta Supabase sola en
# produccion; solo hacen falta aca para correr las functions en local.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Lectura de fichas por foto -------------------------------------------
# Dos proveedores de vision. Con uno alcanza para que el sistema funcione;
# con los dos, que uno se caiga no deja al taller sin cargar fichas.
NVIDIA_API_KEY=nvapi-...
GEMINI_API_KEY=AIza...

# Opcionales: solo para cambiar de modelo sin tocar codigo. Los de NIM
# llegan a fin de vida cada tanto y la API empieza a devolver 410.
# NVIDIA_MODELO=nvidia/nemotron-nano-12b-v2-vl
# GEMINI_MODELO=gemini-3.6-flash

# Cuanto razona Gemini antes de contestar: minimal | low | medium | high.
# Vacio (el default) lo deja decidir solo, que es como venia.
#
# Gemini gasta 4000-5000 tokens de salida contra los ~1000 de NIM, casi
# todos de "thought": bajarlo acorta la espera de verdad. Pero acorta
# pensando menos sobre letra manuscrita, numeros tachados y comas que no
# son puntos, que es justo la parte dificil. Una ficha lenta cuesta un
# minuto; una ficha mal leida cuesta un motor rebobinado al pedo.
#
# Para probarlo en serio: activarlo, leer las mismas fotos de nuevo y
# comparar contra la transcripcion vieja, que queda en datos_json.
# GEMINI_THINKING=low

# Cual se intenta primero. Cual conviene cambia con la disponibilidad
# real de cada uno, y eso se ve en los logs, no de antemano.
# EXTRACCION_ORDEN=nvidia-nim,gemini

# Tiempos, todos en ms. Los defaults salieron de medir produccion; no
# conviene subirlos sin mirar tambien el limite de reloj de pared de las
# Edge Functions, que son 150s y no se pueden cambiar.
#
#   TIMEOUT   techo de un intento. Un proveedor que va a contestar lo hace
#             en 21-27s; pasados 45 esta colgado, no lento.
#   ADELANTO  si el principal no contesto en este tiempo, el respaldo sale
#             en paralelo en vez de esperar a que el primero se rinda.
#   PRESUPUESTO  techo de todo el trabajo. Tiene que quedar bien por
#             debajo de los 150s: cuando matan la funcion no corre ningun
#             `catch`, y la fila queda trabada en 'procesando' para siempre.
# EXTRACCION_TIMEOUT_MS=45000
# EXTRACCION_ADELANTO_MS=30000
# EXTRACCION_PRESUPUESTO_MS=120000

# Tope diario de lecturas por usuario. Sin techo, un bucle genera una
# factura sorpresa de la API.
# LIMITE_EXTRACCIONES_DIA=80

# Bot de Telegram
TELEGRAM_BOT_TOKEN=123456789:AAA...
# Cadena secreta propia: Telegram la manda en el header
# X-Telegram-Bot-Api-Secret-Token en cada webhook. Sin esto, cualquiera
# que descubra la URL puede simular mensajes.
TELEGRAM_WEBHOOK_SECRET=generar-string-aleatorio-largo

# Facturacion electronica ARCA (ex AFIP)
# !!! ARCA_CERT y ARCA_KEY son el certificado y la clave privada del
# taller ante ARCA. Igual que la service role key: nunca con prefijo
# VITE_, nunca en `configuracion` (esa tabla la lee cualquier usuario
# autenticado) y nunca commiteados. !!!
#
# Con la via propia el sistema firma el ticket de acceso el mismo y
# habla SOAP con WSAA y WSFEv1: la clave privada no sale de aca.
# Los dos valores se cargan en PEM tal cual, o en base64 del PEM si el
# multilinea da problemas al pegarlo.
#
#   homologacion -> se sacan en WSASS (clave fiscal nivel 3, adherir el
#                   servicio, subir el CSR, autorizar wsfe)
#   produccion   -> Administracion de Certificados Digitales + el
#                   Administrador de Relaciones
ARCA_CUIT=20xxxxxxxxx
ARCA_CERT=
ARCA_KEY=
# false hasta tener certificado y punto de venta habilitados de verdad.
# Que un deploy mal configurado falle hacia homologacion, no al reves.
ARCA_PRODUCCION=false

# 'propio' (default) habla directo con ARCA. 'sdk' vuelve a la via vieja
# por app.afipsdk.com; existe para comparar las dos y para poder volver
# atras cambiando un solo secret. Se va, junto con el token de abajo,
# cuando la via propia autorice su primera factura.
ARCA_VIA=propio
AFIPSDK_ACCESS_TOKEN=


# --- Legacy (server/, se elimina al terminar la migracion) -----------------
# MONGO_URI=mongodb://127.0.0.1:27017/gestor-taller
