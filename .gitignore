# Dependencias de Node (son muy pesadas, no se suben)
node_modules/

# Archivos de entorno (tienen claves secretas, NUNCA se suben)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs de errores
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema operativo (basura)
.DS_Store
Thumbs.db

# Build de producción (se genera automáticamente al desplegar)
dist/
build/

server/seeder.js

# Scripts locales de migracion / debug: suelen llevar credenciales embebidas.
# Nunca se commitean; si un script debe versionarse, lee de process.env.
*.local.js
*.local.mjs
scripts/tmp/

# Supabase CLI
supabase/.branches/
supabase/.temp/
.env.*.local